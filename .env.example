# Conversation Memory MCP — configuración personal con npx
#
# Cada usuario crea su propia base en Neon (gratuito) y ejecuta el MCP
# localmente. Los chats nunca se mezclan porque están en bases distintas.

# Conexión exclusiva de Conversation Memory. No reutiliza DATABASE_URL de la
# aplicación anfitriona. El instalador la crea/solicita y muestra el destino
# antes de migrarlo.
CONVERSATION_MEMORY_DATABASE_URL=postgresql://neondb_owner:tu_clave@ep-tu-proyecto-region.aws.neon.tech/neondb?sslmode=require

# Solo para servidores PostgreSQL con certificado propio/no verificable.
# Mantenerlo sin definir usa la validación TLS normal indicada por la URL.
# PGSSL_REJECT_UNAUTHORIZED=false

# Tope de duración de cada query, en milisegundos (default 60000). Lo aplica el
# servidor con statement_timeout, así que Postgres cancela la query y la conexión
# sigue siendo reutilizable. Subirlo solo si una operación legítima (por ejemplo
# un UPDATE masivo como scripts/migrate_sequence.js) necesita más de un minuto.
# CONVERSATION_MEMORY_QUERY_TIMEOUT_MS=60000

# Timeout para llamadas al LLM (default 30000 ms).
# CONVERSATION_MEMORY_LLM_TIMEOUT_MS=30000

# Reintentos para fallos transitorios del LLM (429, 5xx y timeout).
# Default: 2 reintentos adicionales.
# CONVERSATION_MEMORY_LLM_MAX_RETRIES=2
# CONVERSATION_MEMORY_LLM_RETRY_BASE_DELAY_MS=250
# CONVERSATION_MEMORY_LLM_RETRY_MAX_DELAY_MS=2000

# Dueño local de los datos escritos por este proceso MCP.
# En modo clonado/npx local puede ser tu nombre, usuario o equipo.
# Si se omite, el runtime usa el owner local seguro "local-user".
MCP_DEFAULT_OWNER=local-user

# GEMINI_API_KEY (opcional) — proveedor de LLM alternativo. Se usa cuando no hay
# OPENROUTER_API_KEY o si se fuerza con AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# OPENROUTER_API_KEY (opcional) — proveedor usado por defecto cuando está
# configurado. El modelo predeterminado es Nemotron 120B gratuito:
# nvidia/nemotron-3-super-120b-a12b:free
# Los modelos gratuitos están sujetos a los límites y disponibilidad vigentes
# de OpenRouter; consultá su documentación para conocer la cuota actual.
# OPENROUTER_API_KEY=

# AI_MODEL (opcional) — permite elegir otro modelo sin modificar el código.
# Si se usa OpenRouter y se omite, se utiliza Nemotron 120B :free.
# Si se usa Gemini y se omite, se utiliza gemini-2.5-flash-lite.
# AI_MODEL=

# AI_PROVIDER (opcional) — "openrouter" o "gemini". Si se omite, se autodetecta:
# openrouter si existe OPENROUTER_API_KEY; si no, gemini si existe GEMINI_API_KEY.
# AI_PROVIDER=

# Embeddings son opcionales. En false, las búsquedas semánticas usan fallback
# léxico y no se descarga el modelo Hugging Face.
ENABLE_EMBEDDINGS=true

# Batching/backpressure del worker stdio. La cola es volátil; el worker recupera
# pendientes desde la DB. El backoff idle llega a 15 minutos para permitir que
# Neon suspenda el compute.
EMBEDDING_BATCH_SIZE=10
EMBEDDING_QUEUE_MAX_SIZE=1000
EMBEDDING_POLL_INTERVAL_MS=5000
EMBEDDING_MAX_POLL_INTERVAL_MS=900000

# ============================================
# Modo HTTP / despliegue remoto (multi-tenant)
# ============================================
# Estas variables solo aplican si corrés el servidor con `node src/server.js`
# (por ejemplo desplegado en Render). En modo local/npx (stdio) no se usan.

# Token maestro de administración. Obligatorio para que el servidor arranque
# en modo HTTP. Da acceso total, sin restricción de owner — usarlo solo para
# administración (generar/revocar API keys), no como token de uso normal.
# MCP_BEARER_TOKEN=

# Puerto HTTP. Render lo inyecta automáticamente; en otros hosts podés fijarlo.
# PORT=3000

# Activa el worker de embeddings en modo servidor HTTP (en modo stdio el
# worker arranca solo). Default: false.
# ENABLE_EMBEDDING_WORKER=false





# Preserved hardening configuration
# Tope global de resultados para búsquedas de mensajes (default 50).
# También limita los valores solicitados por semanticSearchMessages.
# SEARCH_MESSAGES_LIMIT=50
# Tope de mensajes devueltos por recoverSession (default 100).
# Un limit solicitado por el agente nunca puede superar este máximo.
# RECOVER_SESSION_LIMIT=100
# Protección DNS-rebinding / navegador para los transportes MCP.
# Listas separadas por comas. Si se configuran, deben coincidir exactamente
# con el Host y Origin recibidos.
# Ejemplo:
# MCP_ALLOWED_HOSTS=conversation-memory-mcp.onrender.com
# MCP_ALLOWED_ORIGINS=https://mi-panel.example.com
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
