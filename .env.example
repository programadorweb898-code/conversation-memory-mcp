# Conversation Memory MCP — configuración personal con npx
#
# Cada usuario crea su propia base en Neon (gratuito) y ejecuta el MCP
# localmente. Los chats nunca se mezclan porque están en bases distintas.

# Tu conexión a Neon.
# - Modo local (npx/stdio): cada usuario tiene la suya, no se comparte.
# - Modo HTTP/remoto: una sola base compartida por todos los usuarios del
#   servidor; el aislamiento entre ellos lo da el token de cada uno, no la
#   base de datos.
DATABASE_URL=postgresql://neondb_owner:tu_clave@ep-tu-proyecto-region.aws.neon.tech/neondb?sslmode=require

# Dueño local de los datos escritos por este proceso MCP.
# En modo clonado/npx local puede ser tu nombre, usuario o equipo.
# Si se omite, el runtime usa el owner local seguro "local-user".
MCP_DEFAULT_OWNER=local-user

# GEMINI_API_KEY (opcional) — proveedor de LLM alternativo. Se usa cuando no hay
# OPENROUTER_API_KEY o si se fuerza con AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# OPENROUTER_API_KEY (opcional) — proveedor usado por defecto cuando está
# configurado. El modelo predeterminado es Nemotron 120B gratuito:
# nvidia/nemotron-3-super-120b-a12b:free
# Los modelos gratuitos están sujetos a los límites y disponibilidad vigentes
# de OpenRouter; consultá su documentación para conocer la cuota actual.
# OPENROUTER_API_KEY=

# AI_MODEL (opcional) — permite elegir otro modelo sin modificar el código.
# Si se usa OpenRouter y se omite, se utiliza Nemotron 120B :free.
# Si se usa Gemini y se omite, se utiliza gemini-2.5-flash-lite.
# AI_MODEL=

# AI_PROVIDER (opcional) — "openrouter" o "gemini". Si se omite, se autodetecta:
# openrouter si existe OPENROUTER_API_KEY; si no, gemini si existe GEMINI_API_KEY.
# AI_PROVIDER=

# Tamaño de cada lote que procesa el worker de embeddings en modo stdio.
# Default real: 10 mensajes por lote; el worker se inicia automáticamente.
EMBEDDING_BATCH_SIZE=10

# ============================================
# Modo HTTP / despliegue remoto (multi-tenant)
# ============================================
# Estas variables solo aplican si corrés el servidor con `node src/server.js`
# (por ejemplo desplegado en Render). En modo local/npx (stdio) no se usan.

# Token maestro de administración. Obligatorio para que el servidor arranque
# en modo HTTP. Da acceso total, sin restricción de owner — usarlo solo para
# administración (generar/revocar API keys), no como token de uso normal.
# MCP_BEARER_TOKEN=

# Puerto HTTP. Render lo inyecta automáticamente; en otros hosts podés fijarlo.
# PORT=3000

# Activa el worker de embeddings en modo servidor HTTP (en modo stdio el
# worker arranca solo). Default: false.
# ENABLE_EMBEDDING_WORKER=false

# Finaliza automáticamente sesiones inactivas por más de 5 min. Solo aplica
# en modo HTTP. Default: false (la finalización queda a pedido del usuario).
# ENABLE_SESSION_MONITOR=false

