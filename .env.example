# Conversation Memory MCP — configuración local con npx
#
# Esta configuración usa Neon directamente desde el proceso local del MCP.
# Render NO es necesario para el modo npx.

# DATABASE_URL es la conexión a TU propia base PostgreSQL/Neon.
# Para aislamiento entre usuarios, cada instalación debe utilizar una
# base/credencial de Neon controlada por ese usuario. No compartas esta URL.
# Ejemplo:
# DATABASE_URL=postgresql://user:password@ep-tu-proyecto.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://user:password@host:port/dbname

# GEMINI_API_KEY es opcional y solo se necesita para las funciones que usan Gemini.
# GEMINI_API_KEY=

# MCP_BEARER_TOKEN solo aplica al servidor HTTP remoto existente.
# No es necesario para `npx conversation-memory-mcp`.
# MCP_BEARER_TOKEN=
