# Configuración del servidor
# Copiá este archivo a .env y completá los valores.

# DATABASE_URL: cadena de conexión a PostgreSQL.
# ⚠️ El proyecto usa NEON (no el Postgres de Render). Ejemplo:
#    DATABASE_URL=postgresql://user:password@ep-tu-proyecto.region.aws.neon.tech/conversation_memory_db?sslmode=require
# La URL de Neon se obtiene en tu panel de Neon (Dashboard -> Connection Details -> Connection string).
# No uses la URL del Postgres de Render; la migración de proyectos lo bloquea.

DATABASE_URL=postgresql://user:password@host:port/dbname

# GEMINI_API_KEY: API Key para acceder a los servicios de IA de Google

# MCP_BEARER_TOKEN: token para autenticar las peticiones HTTP hacia el servidor MCP
