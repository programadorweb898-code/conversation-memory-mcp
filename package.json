{
  "name": "conversation-memory-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP para almacenar y recuperar el historial de conversaciones de forma persistente mediante PostgreSQL.",
  "main": "src/server.js",
  "bin": {
    "conversation-memory-mcp": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:stdio": "node src/stdio.js",
    "test": "mocha --timeout 30000 tests/",
    "dev": "node src/server.js",
    "lint": "eslint .",
    "migrate": "node scripts/migrate.js",
    "install:plugin": "node scripts/install-plugin.js",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "postgresql",
    "pgvector",
    "neon"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "scripts/migrate.js",
    "scripts/create-api-key.js",
    "scripts/install-plugin.js",
    "migrations/",
    "plugins/",
    "docs/",
    ".env.example",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@huggingface/transformers": "^4.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.22.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "eslint": "^9.39.4",
    "mocha": "^12.0.2",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programadorweb898-code/conversation-memory-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/programadorweb898-code/conversation-memory-mcp/issues"
  },
  "homepage": "https://github.com/programadorweb898-code/conversation-memory-mcp#readme",
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.13.8",
    "ip-address": "^10.6.0",
    "fast-uri": "^3.1.8",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0"
  }
}
